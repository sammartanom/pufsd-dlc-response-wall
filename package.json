{
  "name": "pufsd-dlc-response-wall",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler pages dev public --d1 DB=pufsd-dlc-responses",
    "deploy": "wrangler pages deploy public --project-name pufsd-dlc-response-wall",
    "db:local": "wrangler d1 execute pufsd-dlc-responses --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute pufsd-dlc-responses --remote --file=./schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4.45.0"
  }
}
